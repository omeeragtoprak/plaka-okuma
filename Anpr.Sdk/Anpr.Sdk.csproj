<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- NuGet paket kimliği: PMS bu paketi (ya da ProjectReference) ekleyip AnprRuntime kullanır.
         Native bağımlılıklar (ONNX Runtime, SkiaSharp) NuGet üzerinden geldiği için DLL'leri elle
         kopyalamak yerine paket/proje referansı KULLANILMALIDIR (runtimes/ klasörü kaybolur). -->
    <PackageId>Anpr.Sdk</PackageId>
    <Version>0.9.0</Version>
    <Authors>Erzurum Büyükşehir Belediyesi BİM</Authors>
    <Company>Erzurum Büyükşehir Belediyesi</Company>
    <Description>CPU-only Türk plaka tanıma (ANPR): RTSP kamera -> çok-kareli oylama -> plaka olayı. Otopark yazılımına doğrudan gömülebilir çalışma zamanı (AnprRuntime).</Description>
    <PackageTags>anpr;plate-recognition;turkish-plates;onnx;cpu;rtsp;parking</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/omeeragtoprak/plaka-okuma</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- Symbols + SourceLink (M19): saha çökme yığınları kaynağa çözümlensin. Yalnız pack'i etkiler. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Anpr.Core\Anpr.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Anpr.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Modeller (~17MB) pakete assets/ altında gömülür; tüketicinin çıktı dizinine kopyalamayı
       build/Anpr.Sdk.targets yapar (contentFiles yolu ikililerde CS2015'e düşebiliyor).
       ProjectReference tüketicileri için Link+CopyToOutput da burada. Yollar
       AnprServiceOptions.*ModelPath ile ezilebilir. -->
  <ItemGroup>
    <None Include="..\models\yolo-v9-t-384-license-plates-end2end.onnx;..\models\cct_xs_v2_erz.onnx;..\models\cct_xs_v2_erz_plate_config.yaml;..\models\wpod_lpd.onnx;..\models\fsrcnn_x2.onnx"
          Link="models\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="assets\models\" />
    <None Include="build\Anpr.Sdk.targets" Pack="true" PackagePath="build\Anpr.Sdk.targets" />
  </ItemGroup>

</Project>
