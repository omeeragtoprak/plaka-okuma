<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Allow running on a machine that only has the .NET 9 runtime installed
         (this dev Mac). On the Windows target with the .NET 8 runtime it just
         runs as a normal net8.0 app. -->
    <RollForward>LatestMajor</RollForward>
    <!-- BELLEK (2026-09-30): Web SDK varsayılanı "Server GC"dir — çekirdek başına ayrı yığın açar, çok istekli
         web sunucusu içindir. Bu servis saniyede birkaç kare işler; ölçüm (iki kamera): Server GC ile süreç
         349 MB, iş istasyonu GC ile belirgin biçimde daha az, işlemci/gecikme farkı yok. Zayıf PC'de bellek önceliklidir.
         ⚠️ AD TUZAĞI (2026-10-13, canlıda yakalandı): Web SDK `ServerGarbageCollection`ı (‑ion) props'ta true yapar;
         belgelerde geçen `ServerGarbageCollector` (‑or) Web projesinde ETKİSİZ kalır — ayar yazılı, servis yine
         Server GC ile açılmıştı. Kanıt her zaman üretilen dosyadır: bin/…/Anpr.Service.runtimeconfig.json içinde
         "System.GC.Server": false görülmeli. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Anpr.Core\Anpr.Core.csproj" />
    <ProjectReference Include="..\Anpr.Sdk\Anpr.Sdk.csproj" />
  </ItemGroup>

  <!-- H5/H6: Windows servis barındırma (SCM auto-start + çökme-restart) + rolling DOSYA log
       (Windows serviste console hiçbir yere gitmez → saha teşhisi için dosyaya yaz). Her ikisi de
       non-Windows'ta zararsız (UseWindowsService no-op; dosya-log her yerde çalışır). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
  </ItemGroup>

  <!-- Copy the shared ONNX models + configs into the service output so the
       default relative model paths in appsettings resolve at runtime. -->
  <ItemGroup>
    <None Include="..\models\*.onnx;..\models\*.yaml"
          Link="models\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
