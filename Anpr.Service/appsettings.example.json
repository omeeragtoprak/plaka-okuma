{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",

  "Anpr": {
    "Fps": 2,
    "IdleFps": 1,
    "ActiveHoldSeconds": 4,
    "DedupWindowSeconds": 8,
    "MinConfidence": 0.5,
    "OnnxIntraOpThreads": 2,
    "OnnxAllowSpinning": true,
    "DetectorModelPath": "models/yolo-v9-t-384-license-plates-end2end.onnx",
    "OcrModelPath": "models/cct_xs_v2_global.onnx",
    "OcrConfigPath": "models/cct_xs_v2_global_plate_config.yaml",
    "DetectorScoreThreshold": 0.25,
    "CropPaddingRatio": 0.06,
    "MinPlateWidthRatio": 0.0,
    "ApplyTurkishValidation": true,
    "EmitMinConfidence": 0.0,
    "EmitMinOcrConfidence": 0.45,
    "MinConfirmations": 2,
    "SettleWindowSeconds": 3,
    "CharacterVoting": true,
    "ConstrainedDecoding": true,
    "MergeAcrossProvince": false,
    "FuzzyMergeDistance": 1,
    "DeskewPlates": false,
    "HttpPort": 8080,
    "HttpBindAddress": "0.0.0.0",
    "RecentEventsCapacity": 200,
    "WebhookUrl": null,
    "Ffmpeg": {
      "Path": "ffmpeg",
      "RtspTransport": "tcp",
      "JpegQuality": 4,
      "ScaleWidth": 0,
      "NoFrameTimeoutSeconds": 12,
      "MaxBackoffSeconds": 30,
      "ExtraInputArgs": null
    },
    "Cameras": [
      {
        "Id": "giris",
        "Name": "Giriş",
        "Ip": "CAMERA_IP_1",
        "Username": "CAMERA_USERNAME",
        "Password": "CAMERA_PASSWORD",
        "RtspUrl": "rtsp://CAMERA_USERNAME:CAMERA_PASSWORD@CAMERA_IP_1:554/Streaming/Channels/101"
      },
      {
        "Id": "cikis",
        "Name": "Çıkış",
        "Ip": "CAMERA_IP_2",
        "Username": "CAMERA_USERNAME",
        "Password": "CAMERA_PASSWORD",
        "RtspUrl": "rtsp://CAMERA_USERNAME:CAMERA_PASSWORD@CAMERA_IP_2:554/Streaming/Channels/101"
      }
    ]
  }
}
